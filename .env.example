# ─────────────────────────────────────────────────────────────
#  LOCAL (pnpm dev): un solo proceso con frontend + Payload
# ─────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://postgres:password@127.0.0.1:5432/soyroman
PAYLOAD_SECRET=cambia-esto
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CMS_URL=http://localhost:3000
PREVIEW_SECRET=
# Opcionales (ya existían)
BLOB_READ_WRITE_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ─────────────────────────────────────────────────────────────
#  VERCEL (frontend · soyroman.com) — sin DATABASE_URI ni PAYLOAD_SECRET
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SERVER_URL=https://soyroman.com     ← con https://
# CMS_URL=https://cms.soyroman.com
# REVALIDATE_SECRET=<cadena larga aleatoria, igual que en Hall>
# CMS_REVALIDATE_SECONDS=3600                    (respaldo si falla el webhook)

# ─────────────────────────────────────────────────────────────
#  HALL (.env.hall · CMS · cms.soyroman.com)
# ─────────────────────────────────────────────────────────────
# POSTGRES_DB=soyroman
# POSTGRES_USER=soyroman
# POSTGRES_PASSWORD=<aleatoria>
# PAYLOAD_SECRET=<aleatoria, 32+ caracteres>
# PAYLOAD_PUBLIC_SERVER_URL=https://cms.soyroman.com
# FRONTEND_URL=https://soyroman.com
# REVALIDATE_SECRET=<la misma que en Vercel>
# PREVIEW_SECRET=<aleatoria>

# Velocidad real y comparador: API key de Google Cloud con PageSpeed Insights API y Chrome UX Report API habilitadas
PAGESPEED_API_KEY=

# ¿Te recomienda la IA?: clave de Google AI Studio en un proyecto SIN facturación (el tope es la cuota gratuita)
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-flash-latest)
GEMINI_MODEL=
# Opcional: 1 = Gemini busca en Google antes de responder (requiere proyecto con facturación)
GEMINI_GROUNDING=

# Enlace de HubSpot Meetings para el botón "Agendar" en /consultoria (opcional)
NEXT_PUBLIC_MEETINGS_URL=

# ─────────────────────────────────────────────────────────────
#  MI TALLER (Vercel): cuentas y resultados guardados
# ─────────────────────────────────────────────────────────────
# Cadena de conexión de Neon (la "pooled"); también la usa drizzle-kit para las migraciones
TALLER_DATABASE_URL=…
# Secreto de sesiones: openssl rand -base64 32
BETTER_AUTH_SECRET=…
# Opcional: entrar con Google (OAuth de Google Cloud). Con las dos claves, pon NEXT_PUBLIC_GOOGLE_LOGIN=1
GOOGLE_CLIENT_ID=…
GOOGLE_CLIENT_SECRET=…
NEXT_PUBLIC_GOOGLE_LOGIN=…
